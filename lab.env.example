# Optional local overrides. Copy to lab.env (gitignored) and uncomment what you need.
# Makefile syntax: `?=` lets a shell export still win over these values.
#
# Image tags: only needed if `docker images` shows different tags than the
# defaults in topology/lab.clab.yml.
#C8KV_IMAGE  ?= vrnetlab/cisco_c8000v:17.13.01a
#XRV9K_IMAGE ?= vrnetlab/cisco_xrv9k:24.3.1
#N9KV_IMAGE  ?= vrnetlab/cisco_n9kv:9500-lite-10.5.5.M
#
# N9Kv sizing: defaults are for the lite image; full N9Kv needs 10240 / 4.
#N9KV_MEMORY ?= 6144
#N9KV_SMP    ?= 2
#
# Nodes excluded from the gNMI smoke test (default: xe1 xr1). "none" = test all.
#GNMI_SKIP   ?= xe1 xr1
#
# Different topology file
#TOPO        ?= topology/lab.clab.yml
