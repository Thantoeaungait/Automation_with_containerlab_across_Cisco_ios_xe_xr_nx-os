# Copy to lab.env and set the tags shown by `docker images` after scripts/01-build-images.sh.
# Makefile syntax (?=) so that shell exports still override these values.
C8KV_IMAGE  ?= vrnetlab/cisco_c8000v:17.13.01a
N9KV_IMAGE  ?= vrnetlab/cisco_n9kv:9500-lite-10.5.5.M
N9KV_MEMORY ?= 6144
N9KV_SMP    ?= 2
XRV9K_IMAGE ?= vrnetlab/cisco_xrv9k:24.3.1
XRD_IMAGE   ?= ios-xr/xrd-control-plane:24.4.1
